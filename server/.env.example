# Copy to .env on the hosting platform. Never commit real values.
PORT=8080
DATABASE_URL=postgres://USER:PASSWORD@POSTGRES_HOST:5432/world_in_pieces
PLATFORMS=site
ALLOWED_ORIGINS=https://YOUR_GITHUB_PAGES_OR_DOMAIN
PUBLIC_SITE_URL=https://YOUR_GITHUB_PAGES_OR_DOMAIN/
RESEND_API_KEY=REPLACE_IN_HOSTING_SECRETS
MAIL_FROM=World in Pieces <noreply@YOUR_VERIFIED_DOMAIN>
SESSION_DAYS=30
TEST_SPARKS=0
TRUST_PROXY=1
# Credentials used only when VK/Yandex server adapters are enabled:
# VK_SECRET=
# YANDEX_SECRET=
